# AgriProof settings. `make setup` copies this to .env and fills in the secrets.
# Never share or commit your .env file.

# --- Security (generated by make setup) ---
# Service access key for scripts and integrations (header X-API-Key). People sign in with personal accounts instead.
API_KEY=change-me-to-a-long-random-string
# Secret that protects SMS login codes. Changing it invalidates codes that were already sent.
SESSION_SECRET=
# Set to true only when AgriProof runs behind your own HTTPS reverse proxy (the production setup does this).
TRUST_PROXY=false
# Which network address the API listens on. 127.0.0.1 = this computer only.
# Set to 0.0.0.0 to let a phone on the same Wi-Fi reach it while testing the field app (trusted networks only).
API_BIND=127.0.0.1

# --- Going online (production server only) ---
# Your domain or subdomain, already pointing to the server's IP address.
DOMAIN=

# --- Database password (used by docker compose) ---
POSTGRES_PASSWORD=agri_dev_password

# --- Blockchain anchoring ---
# Local development uses the built-in blockchain. `make deploy-testnet` switches these to Celo Sepolia.
CHAIN_RPC_URL=http://anvil:8545
CHAIN_ID=31337
CHAIN_CONTRACT_ADDRESS=
# Public development key of the built-in local blockchain. Never use it on a real network.
CHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- M-Pesa Daraja ---
# Free sandbox keys: https://developer.safaricom.co.ke . Empty = test payment mode (no money moves).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS address Safaricom calls back to, e.g. https://api.yourdomain.com/mpesa/callback
MPESA_CALLBACK_URL=https://example.com/mpesa/callback

# --- SMS: login codes, delivery receipts, fertilizer checks (Africa's Talking) ---
# Free sandbox account: https://account.africastalking.com . Empty = test mode (codes appear in: make code).
AT_ENV=sandbox
AT_USERNAME=
AT_API_KEY=
# Optional approved sender name, e.g. AGRIPROOF
AT_SENDER_ID=
# Safety cap on text messages per day (stops sign-up floods from draining SMS credit)
SMS_DAILY_LIMIT=500

# Farmers text a bag code to your Africa's Talking number to check fertilizer. Set the incoming-message
# callback to https://YOUR-DOMAIN/sms/inbound/<INBOUND_SECRET> (INBOUND_SECRET is generated by make setup).

# Public address of this system, printed in the check links on bag labels (e.g. https://agriproof.example.com)
PUBLIC_URL=

# Backups (make backup). BACKUP_PASSPHRASE is generated by make setup: write it down, it opens your backups.
BACKUP_PASSPHRASE=
# Folder for backups (empty = ~/agriproof-backups), how many to keep, and an optional second folder
# for an extra copy (for example a USB drive or a Google Drive folder synced to this computer)
BACKUP_DIR=
BACKUP_KEEP=14
BACKUP_COPY_DIR=

# Phone alerts through Telegram (free). Run: make telegram-setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Daily "all good" report hour, East Africa time (-1 turns it off)
MONITOR_SUMMARY_HOUR=8

# Payments: auto picks IntaSend if its keys are set, then Safaricom (MPESA_*), else test mode.
# Force one with: test | intasend | mpesa
PAYMENTS_PROVIDER=auto
# IntaSend keys from https://intasend.com (Settings > API Keys). Start with sandbox keys and INTASEND_ENV=sandbox.
INTASEND_SECRET_KEY=
INTASEND_PUBLISHABLE_KEY=
INTASEND_ENV=sandbox
# Optional: a specific IntaSend wallet to collect into and pay out from
INTASEND_WALLET_ID=
# The "challenge" text you set for webhooks in the IntaSend dashboard; webhook URL: https://YOUR-DOMAIN/payments/intasend/webhook
INTASEND_WEBHOOK_CHALLENGE=
# Largest single payment to one farmer, and how far (in shillings) the daily money check may differ before it alerts
PAYOUT_MAX=300000
RECON_TOLERANCE=0
# Money held back per farmer payment for the payment company's fee until the real fee is known (live payments only)
PAYOUT_FEE_RESERVE=120

# Generated by make setup. MONITOR_API_KEY lets the watchman read (never change) data.
# INBOUND_SECRET goes at the end of the incoming-SMS callback URL (see above).
MONITOR_API_KEY=
INBOUND_SECRET=
